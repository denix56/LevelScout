Init.lua

# The baked ForeverDB layer, generated by tools/import/import.lua. Do not edit; re-run the import.
# Quests, NPCs, objects and items come from the QuestieDB addon at runtime (adapters\Merge.lua).
data\Meta.lua
data\Quests.lua
data\QuestSpots.lua
data\Npcs.lua
data\Objects.lua
data\Items.lua
data\World.lua

# Adapters: the only files that touch the game API, other addons or the raw data.
adapters\Merge.lua
adapters\Data.lua
adapters\Game.lua
adapters\TomTom.lua

# Core: pure Lua (no game API). Cost model, quest model, route planner, zone ranking.
core\Geo.lua
core\Cost.lua
core\Learn.lua
core\Travel.lua
core\Model.lua
core\Planner.lua
core\Objective.lua
core\Search.lua
core\Memory.lua
core\Zones.lua

Async.lua
Guide.lua
Tracker.lua
Engine.lua
AutoQuest.lua

# UI: draws ns.Engine.view.
ui\Format.lua
ui\Window.lua
ui\Minimap.lua
ui\FlightMap.lua
ui\Debug.lua

Commands.lua
